---
import SiteDocument from '../layouts/SiteDocument.astro'
import ArchiveIntro from '../components/ArchiveIntro.astro'
import { LeaderboardPage, ChartsPage } from '../components/Comparisons'
import { ModelPage, TranscriptPage, MethodologyPage, LimitationsPage, DownloadsPage } from '../components/StaticPages'
import { getAllModels, getArchivedModels, getComparisonModels } from '../lib/data'

export function getStaticPaths() {
  return [
    ...['models', 'charts', 'archive', 'methodology', 'limitations', 'downloads'].map(path => ({ params: { path }, props: { page: path, modelId: '', run: 1 } })),
    ...[...getAllModels(), ...getArchivedModels()].flatMap(model => [
      { params: { path: `models/${model.model_id}` }, props: { page: 'model', modelId: model.model_id, run: 1 } },
      ...[1, 2, 3].map(run => ({ params: { path: `models/${model.model_id}/transcripts${run === 1 ? '' : `/run-${run}`}` }, props: { page: 'transcript', modelId: model.model_id, run } })),
    ]),
  ]
}
const { page, modelId, run } = Astro.props
---
<SiteDocument>
  {page === 'models' && <LeaderboardPage models={getComparisonModels()} client:load />}
  {page === 'charts' && <ChartsPage models={getComparisonModels()} client:load />}
  {page === 'archive' && <><ArchiveIntro /><LeaderboardPage models={getComparisonModels(true)} archived client:load /><ChartsPage models={getComparisonModels(true)} archived client:load /></>}
  {page === 'model' && <ModelPage modelId={modelId} />}
  {page === 'transcript' && <TranscriptPage modelId={modelId} run={run} />}
  {page === 'methodology' && <MethodologyPage />}
  {page === 'limitations' && <LimitationsPage />}
  {page === 'downloads' && <DownloadsPage />}
</SiteDocument>
